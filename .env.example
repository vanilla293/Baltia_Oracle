# ════════════════════════════════════════════════════════════════════
#  Baltia Oracle — настройки
#
#  Скопируй этот файл в .env и заполни:
#    Linux / macOS:  cp .env.example .env
#    Windows:        copy .env.example .env   (или просто запусти start.bat — он сделает сам)
#
#  Обязательно: BOT_TOKEN и DEEPSEEK_API_KEY. OWNER_ID — после первого /start.
#  Для голосовых — GROQ_API_KEY (бесплатно) или локальный whisper.
#  Всё остальное можно не трогать: пустое значение = умолчание.
#
#  Комментарий пиши ТОЛЬКО отдельной строкой, начиная с #.
#  «KEY=значение # комментарий» на одной строке ломает значение.
#  Кавычки вокруг значений не нужны.
# ════════════════════════════════════════════════════════════════════


# ─── Telegram ─────────────────────────────────────────────────────────

# Токен бота от @BotFather (вид: 1234567890:AAE...)
BOT_TOKEN=

# Твой числовой id в Telegram. Не знаешь — оставь пустым, запусти бота
# и напиши ему /start: он пришлёт id. Впиши сюда и перезапусти.
# Бот слушается только тебя, остальным отвечает «Это личный бот».
# (Если когда-нибудь понадобится второй человек со своей отдельной памятью —
#  OWNER_ID=твой,его. Первый — главный.)
OWNER_ID=

# 1 — чужой, написавший /start, попросится: тебе придёт «Пустить?» с кнопкой. По умолчанию выключено.
ALLOW_REQUESTS=0

# Адрес своего Bot API сервера (telegram-bot-api). Обычно не нужно — пусто = api.telegram.org
TELEGRAM_API_URL=
# (Переменная окружения ENV_FILE=путь — читать настройки из другого файла вместо этого .env.
#  В самом .env её писать бессмысленно.)

# Как зовут бота (так он себя называет)
BOT_NAME=Оракул

# Как зовут тебя — чтобы обращался по имени
OWNER_NAME=

# Твой пол: m | f — в каком роде бот говорит о тебе и пишет поздравления от твоего имени («рад» / «рада»)
OWNER_GENDER=m


# ─── Модель: DeepSeek или любой OpenAI-совместимый API ───────────────

# Ключ DeepSeek: platform.deepseek.com → API keys (начинается с sk-).
# Нужен положительный баланс, иначе ошибка 402.
# Можно несколько через запятую: sk-основной,sk-запасной — если на первом кончатся
# деньги или его отзовут (402/401), бот сам перейдёт на следующий.
DEEPSEEK_API_KEY=

# Ключ другого провайдера, если LLM_BASE_URL — не DeepSeek (OpenRouter и т.п.).
# Для Ollama / LM Studio ключ не нужен, но поле не должно быть пустым: впиши ollama.
# Если заданы оба ключа: для адреса DeepSeek берётся DEEPSEEK_API_KEY, для любого другого — LLM_API_KEY.
LLM_API_KEY=

# Адрес API.
#   DeepSeek:   https://api.deepseek.com
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
LLM_BASE_URL=https://api.deepseek.com

# Модель для обычного разговора и инструментов (быстрый режим)
LLM_MODEL=deepseek-flash

# Модель для глубокого режима: сложные вопросы, /deep, разбор идей, дайджест, ночная рефлексия.
# Пусто = deepseek-v4-pro у DeepSeek (у другого провайдера — та же, что LLM_MODEL).
# Если DeepSeek её снимет с API, бот сам перейдёт на LLM_MODEL.
LLM_MODEL_DEEP=

# Сама выбирает: быстрая модель отвечает на обычное, а сложный вопрос (стратегия, деньги,
# план, разбор аргументов) сама передаёт глубокой — ты увидишь «🧠 включаю глубокий режим».
# 0 — не переключаться самой (глубоко — только по /deep или /mode).
LLM_AUTO_DEEP=1

# Размышление в быстром режиме: off (ответ за секунды) | low | high | max («on» = low).
# Если включить, потолок ответа по умолчанию — 32768 токенов (размышление их тоже тратит).
LLM_FAST_THINKING=off

# Глубина размышления в глубоком режиме: low | high | max | auto (auto — пусть решает модель;
# «medium» понимается как high)
LLM_DEEP_EFFORT=high

# «Температура» 0–2: выше — живее и разнообразнее, ниже — суше и предсказуемее
LLM_TEMPERATURE=1.0

# Потолок длины ответа в токенах: быстрый / глубокий режим
LLM_FAST_MAX_TOKENS=8192
LLM_DEEP_MAX_TOKENS=65536

# Сколько секунд ждать один ответ модели: быстрый / глубокий режим
LLM_FAST_TIMEOUT=120
LLM_DEEP_TIMEOUT=600

# Сколько секунд может занять весь ответ на одно сообщение (все шаги «модель → инструменты»).
# Пусто — быстрый: max(150, LLM_FAST_TIMEOUT+30); глубокий: max(900, 1,5 × LLM_DEEP_TIMEOUT).
# Не уложился — бот скажет, что не успел, а не будет молчать.
LLM_TURN_BUDGET=
LLM_DEEP_TURN_BUDGET=

# Сколько шагов «подумал → вызвал инструмент» на одно твоё сообщение
LLM_MAX_STEPS=8


# ─── Время ────────────────────────────────────────────────────────────

# Часовой пояс (название IANA). Примеры: Europe/Kaliningrad, Europe/Moscow, Europe/Riga,
# Europe/Samara, Asia/Yekaterinburg, Asia/Novosibirsk, Asia/Vladivostok, Europe/Minsk.
# Понимает и сокращения: MSK, UTC+3. Не распознан — бот скажет об этом в /status и в логе.
TIMEZONE=Europe/Moscow


# ─── Память и диалог ──────────────────────────────────────────────────

# Сколько последних реплик бот держит перед глазами (не меньше 4)
HISTORY_MESSAGES=30

# Сколько старых реплик за раз сворачивать в конспект (не меньше 4)
SUMMARY_CHUNK=20


# ─── Голос: распознавание (голосовое → текст) ────────────────────────

# auto   — сам выберет: Groq (если есть ключ) → OpenAI → локальный whisper → выключено
# groq | openai | local | off — выбрать явно
STT_PROVIDER=auto

# Язык речи
STT_LANGUAGE=ru

# Бесплатный ключ Groq: console.groq.com → API Keys (начинается с gsk_). Самый простой путь.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Или ключ OpenAI (платно)
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Локальное распознавание: pip install -r requirements-voice.txt и STT_PROVIDER=local.
# Работает без интернета; модель скачается один раз в data/whisper.
# Размер модели: tiny | base | small | medium | large-v3 — больше = точнее, но медленнее
WHISPER_MODEL=small
# cpu или cuda (видеокарта NVIDIA)
WHISPER_DEVICE=cpu
# int8 — для процессора, float16 — для видеокарты
WHISPER_COMPUTE_TYPE=int8

# Показывать расшифровку голосового перед ответом: 1 — да, 0 — нет
SHOW_TRANSCRIPT=1


# ─── Голос: ответы голосом (edge-tts, бесплатно, без ключа) ─────────

# Голос: ru-RU-DmitryNeural (мужской) | ru-RU-SvetlanaNeural (женский)
TTS_VOICE=ru-RU-DmitryNeural

# off    — отвечать только текстом (по умолчанию)
# mirror — на голосовое отвечать и голосом (на текст — текстом)
# always — всегда дублировать голосом
# Озвучка бесплатная (голоса Microsoft Edge), DeepSeek на неё не тратится.
# Переключить из чата: /voice или «отвечай голосом» / «только текстом».
TTS_DEFAULT=off

# Сколько символов озвучивать; длиннее — озвучит начало, остальное прочитаешь в тексте
TTS_MAX_CHARS=1500


# ─── Расписание: местное время ЧЧ:ММ, off — выключить ───────────────

# Утренняя сводка: события, напоминания, дни рождения, задачи, погода
MORNING_BRIEF_TIME=08:00

# Дайджест новостей
NEWS_DIGEST_TIME=09:00

# Ночная рефлексия: дневник, пересмотр своих позиций, к чему вернуться завтра
REFLECTION_TIME=03:30

# Дни рождения: предупредить заранее и поздравить в сам день (потом «Поздравить…» раз в час с 9:00 до 22:00,
# пока не отметишь). Бот был выключен — догонит в тот же день, когда включится.
BIRTHDAY_TIME=09:00


# ─── Напоминания ─────────────────────────────────────────────────────

# Раз в сколько минут «долбить», пока не нажмёшь «Готово»
NAG_INTERVAL_MIN=3

# Сколько раз долбить, прежде чем сдаться
NAG_MAX=20

# Будильник снимается только решённой задачкой: 1 — да, 0 — обычной кнопкой
WAKE_CHALLENGE=1


# ─── Новости, интернет, погода ───────────────────────────────────────

# RSS-ленты через запятую. Пусто = встроенный набор из разных лагерей:
# ТАСС, РИА Новости, Интерфакс, РБК, Коммерсантъ, Медуза, Би-би-си (рус. и англ.),
# DW, Al Jazeera, The Guardian
NEWS_FEEDS=

# Поиск в интернете (DuckDuckGo, без ключа): 1 — да, 0 — нет
WEB_SEARCH=1

# Твой город для погоды (Open-Meteo, без ключа), например: Калининград
WEATHER_CITY=

# Или точные координаты — тогда город нужен только как подпись. Пример: 54.71 и 20.51
WEATHER_LAT=
WEATHER_LON=


# ─── Userbot: чтение своих чатов (по желанию, подробно — в README) ──

# 1 — включить. Потом один раз войти: python -m oracle.userbot_login
USERBOT_ENABLED=0

# С my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Путь к файлу сессии (без .session); относительный — от папки проекта. Пусто = data/userbot → файл data/userbot.session.
# Этот файл — ПОЛНЫЙ доступ к твоему аккаунту. Никому не отдавай.
# В Docker не действует: сессия всегда в ./data (так задано в docker-compose.yml).
USERBOT_SESSION=

# Сообщать о новых личных сообщениях с кнопкой «Предложить ответ»: 1 — да, 0 — нет
USERBOT_NOTIFY=0


# ─── Хранилище и логи ────────────────────────────────────────────────

# Папка с данными. Пусто = data рядом с кодом.
# В Docker DATA_DIR, DB_PATH и USERBOT_SESSION не действуют: данные всегда в ./data рядом с docker-compose.yml
# (иначе они легли бы внутрь контейнера и пропали бы при пересборке).
DATA_DIR=

# Файл базы (относительный путь — от папки проекта). Пусто = oracle.db в папке данных
DB_PATH=

# Подробность лога: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
